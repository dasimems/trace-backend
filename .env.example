NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/trace
REDIS_CONNECTION_STRING=redis://localhost:6379

COOKIE_SECRET=replace-with-at-least-32-char-random-string

# All four are required by the encryption + auth layers. Use long random strings.
AUTH_SECRET_KEY=
AUTH_HASH_KEY=
OTP_SECRET_KEY=
OTP_HASH_KEY=
OTP_HASH_SALT=Sup3rS@feSalt!

PASSWORD_SECRET=
PASSWORD_HASH=
# Must match passwordRegexp (>=8 chars, upper+lower+digit+special)
PASSWORD_SALT=Sup3rS@feSalt!

# Trust proxy: "*" or "true" (trust all), "false", a hop count like "1",
# or a comma-separated list of IPs.
PROXY_IPS=*
# Comma-separated list of origins allowed by CORS. Leave blank during dev.
CORS_ORIGINS=

# Cloudinary for storage in case of file, image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SendGrid (must start with SG.) for email sending
SENDGRID_API_KEY=
SENDGRID_SENDER_EMAIL=
SENDGRID_SENDER_NAME=Trace

SUPPORT_EMAIL=
# E.164 format, e.g., +2348012345678
SUPPORT_MOBILE_NUMBER=

# Squad (https://docs.squadco.com). Default is sandbox; switch to
# https://api-d.squadco.com in production. Beneficiary is the 10-digit GTBank
# account that virtual-account funds settle into (optional — leave blank to
# settle to the merchant wallet on T+1).
SQUAD_SECRET_KEY=
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
SQUAD_BENEFICIARY_ACCOUNT=

# LLM - any OpenAI-compatible provider powers the weekly AI summary,
# recommendation phrasing, per-product rationales, and Copilot chat.
# Optional: if blank, insights fall back to deterministic copy and the
# copilot returns 503.
#
# Examples (set BASE_URL + MODEL to whichever provider you have a key for):
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1            LLM_MODEL=gpt-4o-mini
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1         LLM_MODEL=openai/gpt-4o-mini
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1       LLM_MODEL=llama-3.3-70b-versatile
#   Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1         LLM_MODEL=claude-sonnet-4-6
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1            LLM_MODEL=llama3.2
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini