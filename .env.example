NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/trace
REDIS_CONNECTION_STRING=redis://localhost:6379

COOKIE_SECRET=replace-with-at-least-32-char-random-string

# All four are required by the encryption + auth layers. Use long random strings.
AUTH_SECRET_KEY=
AUTH_HASH_KEY=
OTP_SECRET_KEY=
OTP_HASH_KEY=
OTP_HASH_SALT=Sup3rS@feSalt!

PASSWORD_SECRET=
PASSWORD_HASH=
# Must match passwordRegexp (>=8 chars, upper+lower+digit+special)
PASSWORD_SALT=Sup3rS@feSalt!

# Trust proxy: "*" or "true" (trust all), "false", a hop count like "1",
# or a comma-separated list of IPs.
PROXY_IPS=*
# Comma-separated list of origins allowed by CORS. Leave blank during dev.
CORS_ORIGINS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SendGrid (must start with SG.)
SENDGRID_API_KEY=
SENDGRID_SENDER_EMAIL=
SENDGRID_SENDER_NAME=Trace

SUPPORT_EMAIL=
# E.164 format, e.g., +2348012345678
SUPPORT_MOBILE_NUMBER=
