NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/trace
REDIS_CONNECTION_STRING=redis://localhost:6379

COOKIE_SECRET=replace-with-at-least-32-char-random-string

# All four are required by the encryption + auth layers. Use long random strings.
AUTH_SECRET_KEY=
AUTH_HASH_KEY=
OTP_SECRET_KEY=
OTP_HASH_KEY=
OTP_HASH_SALT=Sup3rS@feSalt!

PASSWORD_SECRET=
PASSWORD_HASH=
# Must match passwordRegexp (>=8 chars, upper+lower+digit+special)
PASSWORD_SALT=Sup3rS@feSalt!

# Trust proxy: "*" or "true" (trust all), "false", a hop count like "1",
# or a comma-separated list of IPs.
PROXY_IPS=*
# Comma-separated list of origins allowed by CORS. Leave blank during dev.
CORS_ORIGINS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SendGrid (must start with SG.)
SENDGRID_API_KEY=
SENDGRID_SENDER_EMAIL=
SENDGRID_SENDER_NAME=Trace

SUPPORT_EMAIL=
# E.164 format, e.g., +2348012345678
SUPPORT_MOBILE_NUMBER=

# Squad (https://docs.squadco.com). Default is sandbox; switch to
# https://api-d.squadco.com in production. Beneficiary is the 10-digit GTBank
# account that virtual-account funds settle into (optional — leave blank to
# settle to the merchant wallet on T+1).
SQUAD_SECRET_KEY=
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
SQUAD_BENEFICIARY_ACCOUNT=

# Anthropic / Claude — powers the weekly AI summary and recommendation
# phrasing. Optional: if blank, insights endpoints fall back to deterministic
# narrative copy. Model defaults to claude-sonnet-4-6 (best speed/cost/quality
# for narrative generation); set to claude-opus-4-7 if you want the strongest
# model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OAuth — both optional. Endpoints return 503 if the client ID is blank.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
